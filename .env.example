# =========================================================
# IgnakeeAI MCP Supplier Server - variables de entorno
# =========================================================

# -----------------------------
# Docker/Compose
# -----------------------------
# Registro Docker (vac�o = usar valor por defecto/local), (Si usas un registro remoto, pon URL/nombre, por ejemplo: ghcr.io/tu-organizaci�n � myregistry.azurecr.io)
DOCKER_REGISTRY=

# -----------------------------
# Identidad/contacto del proveedor
# -----------------------------
SUPPLIER_VENDOR_NAME=Proveedor IgnakeeAI
SUPPLIER_CONTACT_EMAIL=ventas@proveedor.com
SUPPLIER_CONTACT_PHONE=+34 900 000 000
SUPPLIER_CONTACT_ADDRESS=Calle Ejemplo 123, Madrid
SUPPLIER_BUSINESS_HOURS=Lun-Vie 08:00-18:00

# -----------------------------
# Runtime API (opcional)
# -----------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5100

# -----------------------------
# Autenticaci�n y autorizaci�n
# -----------------------------
# Valores de desarrollo �nicamente. Sustituirlos por secretos externos en producci�n.
Admin__ApiKey=admin-development-key
Mcp__ContractVersion=1.0.0
Mcp__ProtocolVersion=2025-03-26
Mcp__Clients__0__ClientId=legio-development
Mcp__Clients__0__ApiKey=mcp-development-key
Mcp__Clients__0__Scopes__0=catalog.read
Mcp__Clients__0__Scopes__1=availability.read

# -----------------------------
# Base de datos (opcional, override de appsettings.json)
# Usa __ para mapear secciones en .NET
# -----------------------------
DatabaseProvider=sqlite
ConnectionStrings__Catalog=Data Source=/app/data/catalog.db

# -----------------------------
# PostgreSQL (usado por docker-compose.override.yml; obligatorio en producci�n)
# -----------------------------
POSTGRES_DB=supplier_catalog
POSTGRES_USER=supplier_user
POSTGRES_PASSWORD=change_me

# Para producci�n, usar ASPNETCORE_ENVIRONMENT=Production y
# DatabaseProvider=postgresql. No reutilizar estas credenciales de ejemplo.

# -----------------------------
# ERP (opcional)
# Valores v�lidos: odoo | sap | (vac�o para desactivar)
# -----------------------------
Erp__Provider=

# Odoo
Erp__Odoo__BaseUrl=
Erp__Odoo__Database=
Erp__Odoo__Username=
Erp__Odoo__Password=

# SAP
Erp__Sap__BaseUrl=
Erp__Sap__Database=
Erp__Sap__Username=
Erp__Sap__Password=

# -----------------------------
# Ecommerce inventory (opcional)
# HTTP autenticado de solo lectura; no usar /api/mcp del ecommerce
# -----------------------------
EcommerceInventory__Enabled=false
EcommerceInventory__BaseUrl=https://ecommerce.example.com
EcommerceInventory__AuthenticationHeaderName=X-Api-Key
EcommerceInventory__AuthenticationHeaderValue=replace-with-secret
EcommerceInventory__RequestTimeoutSeconds=15
EcommerceInventory__ProductLookupPathTemplate=/api/inventory/v1/products/{productCode}
EcommerceInventory__CatalogSyncPathTemplate=/api/inventory/v1/products/active?page={page}\&pageSize={pageSize}
EcommerceInventory__CatalogSyncPageSize=100